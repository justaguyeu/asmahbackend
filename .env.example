# Copy to .env and change the values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
TIME_ZONE=Africa/Dar_es_Salaam

# PostgreSQL as one URL (what Render gives you). Leave empty to use the POSTGRES_* values below.
# Never put a real database URL in this example file.
DATABASE_URL=

# Leave POSTGRES_DB empty to use SQLite (fine for one office). Fill in for PostgreSQL.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Supabase Storage for borrower photos and the logo (Storage > S3 Connection).
# Leave SUPABASE_URL empty to save uploads in the local media/ folder.
SUPABASE_URL=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_BUCKET=media

# Email for "forgot password" (Gmail example). Without this, emails print in the terminal.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=ASK Company <you@gmail.com>

BACKUP_DIR=./backups
